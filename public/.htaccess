<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /app-portfolio/

    # 1. JANGAN REWRITE jika request mengarah ke file atau folder yang benar-benar ada
    # Ini menjamin file CSS/JS di folder build bisa diakses langsung
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Tambahan keamanan: Jangan rewrite jika path dimulai dengan build atau livewire
    RewriteRule ^(build|livewire) - [L]

    # 3. Kirim sisa request (routes Laravel) ke index.php
    RewriteRule ^ index.php [L]
</IfModule>
